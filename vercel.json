{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, noai, noimageai"
        }
      ]
    },
    {
      "source": "/code-law-and-capital/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/readers/chapter-:n(\\d{2})",
      "destination": "/code-law-and-capital/chapter-:n",
      "permanent": true
    },
    {
      "source": "/readers/chapter-:n(\\d{2}).html",
      "destination": "/code-law-and-capital/chapter-:n",
      "permanent": true
    },
    {
      "source": "/readers",
      "destination": "/code-law-and-capital/",
      "permanent": true
    }
  ]
}
